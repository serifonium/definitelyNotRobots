<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox fx:id = "PantryRoot" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="480.0" prefWidth="720.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.PantryController">
   <children>
      <VBox alignment="CENTER_LEFT" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="78.0">
         <Button mnemonicParsing="false" onAction="#goToGroceryList" text="Grocery List" />
         <Button text="AI Page" onAction="#goToAIPage"/>
         <AnchorPane minHeight="-Infinity" prefHeight="2.0" prefWidth="50.0" scaleX="0.9" style="-fx-background-color: #ff6600;">
            <VBox.margin>
               <Insets bottom="10.0" top="10.0" />
            </VBox.margin></AnchorPane>
         <Button mnemonicParsing="false" onAction="#goToPreferences" text="Dietary Preferences" />
         <AnchorPane minHeight="-Infinity" prefHeight="2.0" prefWidth="50.0" scaleX="0.9" style="-fx-background-color: #ff6600;">
            <VBox.margin>
               <Insets bottom="10.0" top="10.0" />
            </VBox.margin></AnchorPane>
         <Button mnemonicParsing="false" onAction="#goToFitnessTargets" text="Nutrition Goals" />
         <AnchorPane minHeight="-Infinity" prefHeight="2.0" prefWidth="50.0" scaleX="0.9" style="-fx-background-color: #ff6600;">
            <VBox.margin>
               <Insets bottom="10.0" top="10.0" />
            </VBox.margin></AnchorPane>
         <Button mnemonicParsing="false" onAction="#goToSavedRecipeView" text="Saved Recipes" />
      </VBox>
      <VBox alignment="CENTER" prefHeight="400.0" prefWidth="320.0">
         <children>
            <Button mnemonicParsing="false" onMouseClicked="#onAdd" text="+ Add Item">
               <VBox.margin>
                  <Insets bottom="4.0" />
               </VBox.margin>
            </Button>
            <ListView fx:id="pantryListView" onKeyPressed="#EnterToSelect" prefHeight="200.0" prefWidth="100.0" styleClass="green-input" />
         </children>
         <HBox.margin>
            <Insets />
         </HBox.margin>
         <padding>
            <Insets bottom="10.0" left="10.0" right="5.0" top="10.0" />
         </padding>
      </VBox>
      <VBox alignment="CENTER" prefHeight="400.0" prefWidth="320.0">
         <children>
            <GridPane alignment="CENTER">
               <columnConstraints>
                  <ColumnConstraints hgrow="SOMETIMES" maxWidth="145.0" minWidth="10.0" prefWidth="63.0" />
                  <ColumnConstraints hgrow="SOMETIMES" maxWidth="222.0" minWidth="10.0" prefWidth="222.0" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" /><RowConstraints maxHeight="40.0" minHeight="10.0" prefHeight="32.0" vgrow="SOMETIMES" />
                  <RowConstraints maxHeight="80.0" minHeight="73.0" prefHeight="78.0" vgrow="SOMETIMES" />
               </rowConstraints>
               <children>
                  <Label text="Item:" />
                  <Label text="Amount:" GridPane.rowIndex="1" />
                  <TextField fx:id="itemNameField" onKeyPressed="#EnterToSave" promptText="Enter name of item here..." styleClass="green-input" GridPane.columnIndex="1" />
                  <TextField fx:id="itemAmountField" onKeyPressed="#EnterToSave" promptText="Enter amount needed here..." styleClass="green-input" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  <Label text="Notes:" GridPane.rowIndex="3" />
                  <TextArea fx:id="itemNotesField" prefHeight="200.0" prefWidth="200.0" styleClass="green-input" GridPane.columnIndex="1" GridPane.rowIndex="3">
                     <GridPane.margin>
                        <Insets top="3.0" />
                     </GridPane.margin></TextArea>
                  <Label text="Type:" GridPane.rowIndex="2" />
                  <ChoiceBox fx:id="foodTypeField" prefHeight="26.0" prefWidth="224.0" styleClass="green-input" GridPane.columnIndex="1" GridPane.rowIndex="2">
                     <GridPane.margin>
                        <Insets bottom="1.0" top="1.0" />
                     </GridPane.margin></ChoiceBox>
               </children>
            </GridPane>
            <Button fx:id="markButton" mnemonicParsing="false" onMouseClicked="#markUnavailable" prefHeight="26.0" prefWidth="300.0" text="Move to Grocery List">
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </Button>
            <Button mnemonicParsing="false" onMouseClicked="#onEditConfirm" prefHeight="25.0" prefWidth="300.0" style="-fx-background-color: #ff6600;" text="Save Changes">
               <VBox.margin>
                  <Insets bottom="2.0" top="3.0" />
               </VBox.margin>
            </Button>
            <GridPane prefHeight="30.0" prefWidth="327.0">
               <columnConstraints>
                  <ColumnConstraints hgrow="SOMETIMES" maxWidth="293.0" minWidth="10.0" prefWidth="277.0" />
                  <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" maxWidth="137.0" minWidth="10.0" prefWidth="28.0" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints minHeight="10.0" prefHeight="25.0" vgrow="SOMETIMES" />
               </rowConstraints>
               <children>
                  <Button mnemonicParsing="false" onMouseClicked="#onDelete" prefHeight="25.0" prefWidth="25.0" text="T" GridPane.columnIndex="1">
                     <GridPane.margin>
                        <Insets right="2.0" />
                     </GridPane.margin>
                  </Button>
                  <Button mnemonicParsing="false" onMouseClicked="#onCancel" prefHeight="25.0" prefWidth="272.0" text="Discard Changes">
                     <GridPane.margin>
                        <Insets left="3.0" />
                     </GridPane.margin>
                  </Button>
               </children>
            </GridPane>
            <Button mnemonicParsing="false" onMouseClicked="#goToGroceryList" prefHeight="25.0" prefWidth="300.0" text="Go To Grocery List">
               <VBox.margin>
                  <Insets top="1.0" />
               </VBox.margin></Button>
            <Label fx:id="errorText" text="" textFill="RED" />
         </children>
         <HBox.margin>
            <Insets />
         </HBox.margin>
         <padding>
            <Insets bottom="10.0" left="5.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </children>
</HBox>
