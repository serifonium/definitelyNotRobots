<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.definitelynotrobots.SignUpController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label fx:id="welcomeText" />
    <TextField fx:id="usernameInput" promptText="Username" />
    <PasswordField fx:id="passwordInput" promptText="Password" />
    <Button onAction="#onSignUpButtonClick" text="Create Account" />
    <Button fx:id="signInButton" mnemonicParsing="false" onAction="#goToSignIn" text="Sign In" />
    <Label fx:id="errorText" />
    <VBox>

    </VBox>

</VBox>
