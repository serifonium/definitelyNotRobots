<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.GroceryListController">
   <children>
      <VBox alignment="CENTER" prefHeight="400.0" prefWidth="300.0">
         <children>
            <Button mnemonicParsing="false" onMouseClicked="#onAdd" text="+ Add Item">
               <VBox.margin>
                  <Insets bottom="4.0" />
               </VBox.margin>
            </Button>
            <ListView fx:id="groceryListView" prefHeight="200.0" prefWidth="100.0" />
         </children>
         <HBox.margin>
            <Insets />
         </HBox.margin>
         <padding>
            <Insets bottom="10.0" left="10.0" right="5.0" top="10.0" />
         </padding>
      </VBox>
      <VBox alignment="CENTER" prefHeight="400.0" prefWidth="300.0">
         <children>
            <GridPane alignment="CENTER">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="145.0" minWidth="10.0" prefWidth="63.0" />
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="222.0" minWidth="10.0" prefWidth="222.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="80.0" prefHeight="80.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <Label text="Item:" />
                  <Label text="Amount:" GridPane.rowIndex="1" />
                  <TextField fx:id="itemNameField" promptText="Enter name of item here..." GridPane.columnIndex="1" />
                  <TextField fx:id="itemAmountField" promptText="Enter amount needed here..." GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  <Label text="Notes:" GridPane.rowIndex="2" />
                  <TextArea fx:id="itemNotesField" prefHeight="200.0" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
               </children>
            </GridPane>
            <Button mnemonicParsing="false" onMouseClicked="#onEditConfirm" prefHeight="25.0" prefWidth="275.0" text="Save Changes">
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </Button>
            <Button mnemonicParsing="false" onMouseClicked="#onCancel" prefHeight="25.0" prefWidth="275.0" text="Discard Changes" />
            <GridPane prefWidth="285.0">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="258.0" minWidth="10.0" prefWidth="256.0" />
                <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" maxWidth="137.0" minWidth="10.0" prefWidth="29.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <Button mnemonicParsing="false" onMouseClicked="#onDelete" prefHeight="25.0" prefWidth="25.0" text="T" GridPane.columnIndex="1">
                     <GridPane.margin>
                        <Insets right="5.0" />
                     </GridPane.margin>
                  </Button>
                  <Button mnemonicParsing="false" prefHeight="25.0" prefWidth="250.0" text="Push To Pantry">
                     <GridPane.margin>
                        <Insets left="5.0" />
                     </GridPane.margin>
                  </Button>
               </children>
            </GridPane>
             <Button mnemonicParsing="false" onMouseClicked="#goToPantryView" prefHeight="25.0" prefWidth="275.0" text="Go To Pantry" />
            <Label fx:id="errorText" text="" textFill="RED" />
         </children>
         <HBox.margin>
            <Insets />
         </HBox.margin>
         <padding>
            <Insets bottom="10.0" left="5.0" right="10.0" top="10.0" />
         </padding></VBox>
   </children>
</HBox>
