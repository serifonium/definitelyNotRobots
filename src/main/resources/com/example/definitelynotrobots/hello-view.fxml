<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.definitelynotrobots.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Login" />
    <TextField fx:id="usernameInput" promptText="Username" />
    <PasswordField fx:id="passwordInput" promptText="Password" />
    <HBox alignment="CENTER" prefHeight="50.0" prefWidth="200.0" spacing="20.0">
        <Button onAction="#onLoginButtonClick" text="Login" />
        <Button fx:id="signInButton" mnemonicParsing="false" onAction="#onSignUpButtonClick" text="Sign Up" />
    </HBox>
    <Label fx:id="errorText" textFill="#ab0000" />
    <VBox>

    </VBox>

</VBox>
