<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<HBox fx:id="FitnessTargetRoot" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="480.0" prefWidth="654.0" style="-fx-background-color: #eae8e2;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.FitnessTargetsController">
    <children>
        <VBox alignment="CENTER">
            <Button alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#goToGroceryListView" prefHeight="75.0" prefWidth="88.0" style="-fx-background-color: #eae8e2" text="">
                <graphic>
                    <ImageView fitHeight="60.0" fitWidth="65.0" preserveRatio="false">
                        <image>
                            <Image url="@images/groceries.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>
            <AnchorPane maxWidth="-Infinity" minHeight="-Infinity" prefHeight="2.0" prefWidth="80.0" scaleX="0.9" style="-fx-background-color: #ff6600;">
                <VBox.margin>
                    <Insets />
                </VBox.margin></AnchorPane>
            <Button alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#goToSavedRecipesView" prefHeight="75.0" prefWidth="75.0" style="-fx-background-color: #eae8e2" text="">
                <graphic>
                    <ImageView fitHeight="60.0" fitWidth="60.0" preserveRatio="true">
                        <image>
                            <Image url="@images/diet.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>
            <AnchorPane maxWidth="-Infinity" minHeight="-Infinity" prefHeight="2.0" prefWidth="80.0" scaleX="0.9" style="-fx-background-color: #ff6600;">
                <VBox.margin>
                    <Insets />
                </VBox.margin></AnchorPane>
            <Button alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#goToProfileView" prefHeight="75.0" prefWidth="88.0" style="-fx-background-color: #eae8e2" text="">
                <graphic>
                    <ImageView fitHeight="60.0" fitWidth="60.0" preserveRatio="true">
                        <image>
                            <Image url="@images/profile.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>
            <AnchorPane maxWidth="-Infinity" minHeight="-Infinity" prefHeight="2.0" prefWidth="80.0" scaleX="0.9" style="-fx-background-color: #ff6600;">
                <VBox.margin>
                    <Insets />
                </VBox.margin></AnchorPane>
            <Button alignment="CENTER" contentDisplay="CENTER" layoutX="12.0" layoutY="213.0" mnemonicParsing="false" onAction="#goToHomeView" prefHeight="75.0" prefWidth="88.0" style="-fx-background-color: #eae8e2" text="">
                <graphic>
                    <ImageView fitHeight="60.0" fitWidth="60.0" preserveRatio="true">
                        <image>
                            <Image url="@images/home.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>
            <AnchorPane layoutX="10.0" layoutY="299.0" maxWidth="-Infinity" minHeight="-Infinity" prefHeight="2.0" prefWidth="75.0" style="-fx-background-color: #ff6600;">
                <VBox.margin>
                    <Insets />
                </VBox.margin></AnchorPane>
            <Button alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#goToSavedRecipesView" prefHeight="75.0" prefWidth="88.0" style="-fx-background-color: #eae8e2" text="">
                <graphic>
                    <ImageView fitHeight="60.0" fitWidth="60.0" preserveRatio="true">
                        <image>
                            <Image url="@images/recipies.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>
            <AnchorPane layoutX="10.0" layoutY="311.0" maxWidth="-Infinity" minHeight="-Infinity" prefHeight="2.0" prefWidth="80.0" scaleX="0.9" style="-fx-background-color: #ff6600;">
                <VBox.margin>
                    <Insets />
                </VBox.margin></AnchorPane>
            <Button alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#goToAIView" prefHeight="75.0" prefWidth="88.0" style="-fx-background-color: #eae8e2" text="">
                <graphic>
                    <ImageView fitHeight="60.0" fitWidth="60.0" preserveRatio="true">
                        <image>
                            <Image url="@images/ai icon.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>
            <HBox.margin>
                <Insets bottom="10.0" top="10.0" />
            </HBox.margin>
        </VBox>
        <VBox alignment="CENTER_LEFT" prefWidth="500" spacing="15" style="-fx-padding: 40;">


            <Label text="1. Enter your weight and height" />
            <GridPane hgap="10" vgap="10">

                <Label text="Calories:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="Caloriesgoal" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="kcal" GridPane.rowIndex="0" GridPane.columnIndex="2"/>

                <Label text="Target Weight:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="targetWeightField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Label text="kg" GridPane.rowIndex="1" GridPane.columnIndex="2"/>

            </GridPane>

            <Label text="2. (Optional): you can input a custom fitness plan instead" />
            <GridPane hgap="10" vgap="10">

                <Label text="Fats:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="targetfats" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="g" GridPane.rowIndex="0" GridPane.columnIndex="2"/>

                <Label text="Carbohydrates:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="targetcarbs" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Label text="g" GridPane.rowIndex="1" GridPane.columnIndex="2"/>

                <Label text="Protein:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="targetproteins" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                <Label text="g" GridPane.rowIndex="2" GridPane.columnIndex="2"/>


            </GridPane>
            <Button fx:id="savedetails" onAction="#onSaveDetails" text="Set Goals"/>

        </VBox>
    </children>
</HBox>
