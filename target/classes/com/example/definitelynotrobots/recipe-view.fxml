            <Button fx:id="fitnessTargetsButton" alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#goToFitnessTargetsView" prefHeight="75.0" prefWidth="75.0" style="-fx-background-color: #eae8e2" text="">
