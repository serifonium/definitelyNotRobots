<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<HBox fx:id="AiRoot" alignment="CENTER" prefHeight="480.0" prefWidth="854.0" style="-fx-background-color: #eae8e2;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AiController">

    <children>

        <!-- Sidebar -->
        <AnchorPane minHeight="-Infinity" minWidth="-Infinity" prefHeight="480.0" prefWidth="25.0" />

        <VBox alignment="CENTER">
            <Button alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#goToGroceryList" prefHeight="75.0" prefWidth="88.0" style="-fx-background-color: #eae8e2" text="">
                <graphic>
                    <ImageView fitHeight="60.0" fitWidth="65.0" preserveRatio="false">
                        <image>
                            <Image url="@images/groceries.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>
            <AnchorPane maxWidth="-Infinity" minHeight="-Infinity" prefHeight="2.0" prefWidth="80.0" scaleX="0.9" style="-fx-background-color: #ff6600;">
                <VBox.margin>
                    <Insets />
                </VBox.margin></AnchorPane>
            <Button alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#goToFitnessTargets" prefHeight="75.0" prefWidth="75.0" style="-fx-background-color: #eae8e2" text="">
                <graphic>
                    <ImageView fitHeight="60.0" fitWidth="60.0" preserveRatio="true">
                        <image>
                            <Image url="@images/diet.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>
            <AnchorPane maxWidth="-Infinity" minHeight="-Infinity" prefHeight="2.0" prefWidth="80.0" scaleX="0.9" style="-fx-background-color: #ff6600;">
                <VBox.margin>
                    <Insets />
                </VBox.margin></AnchorPane>
            <Button alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#goToProfile" prefHeight="75.0" prefWidth="88.0" style="-fx-background-color: #eae8e2" text="">
                <graphic>
                    <ImageView fitHeight="60.0" fitWidth="60.0" preserveRatio="true">
                        <image>
                            <Image url="@images/profile.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>
            <AnchorPane maxWidth="-Infinity" minHeight="-Infinity" prefHeight="2.0" prefWidth="80.0" scaleX="0.9" style="-fx-background-color: #ff6600;">
                <VBox.margin>
                    <Insets />
                </VBox.margin></AnchorPane>
            <Button alignment="CENTER" contentDisplay="CENTER" layoutX="12.0" layoutY="213.0" mnemonicParsing="false" onAction="#goToHomeView" prefHeight="75.0" prefWidth="88.0" style="-fx-background-color: #eae8e2" text="">
                <graphic>
                    <ImageView fitHeight="60.0" fitWidth="60.0" preserveRatio="true">
                        <image>
                            <Image url="@images/home.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>
            <AnchorPane layoutX="10.0" layoutY="299.0" maxWidth="-Infinity" minHeight="-Infinity" prefHeight="2.0" prefWidth="75.0" style="-fx-background-color: #ff6600;">
                <VBox.margin>
                    <Insets />
                </VBox.margin></AnchorPane>
            <Button alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#goToSavedRecipeView" prefHeight="75.0" prefWidth="88.0" style="-fx-background-color: #eae8e2" text="">
                <graphic>
                    <ImageView fitHeight="60.0" fitWidth="60.0" preserveRatio="true">
                        <image>
                            <Image url="@images/recipies.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>
            <AnchorPane layoutX="10.0" layoutY="311.0" maxWidth="-Infinity" minHeight="-Infinity" prefHeight="2.0" prefWidth="80.0" scaleX="0.9" style="-fx-background-color: #ff6600;">
                <VBox.margin>
                    <Insets />
                </VBox.margin></AnchorPane>
            <Button alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#goToAIPage" prefHeight="75.0" prefWidth="88.0" style="-fx-background-color: #eae8e2" text="">
                <graphic>
                    <ImageView fitHeight="60.0" fitWidth="60.0" preserveRatio="true">
                        <image>
                            <Image url="@images/ai icon.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>
            <HBox.margin>
                <Insets bottom="10.0" top="10.0" />
            </HBox.margin>
        </VBox>

        <AnchorPane minHeight="-Infinity" minWidth="-Infinity" prefHeight="480.0" prefWidth="15.0" />

        <AnchorPane minHeight="-Infinity" minWidth="-Infinity" prefHeight="480.0" prefWidth="2.0" style="-fx-background-color: #2a6c36;">
            <HBox.margin>
                <Insets right="4.0" />
            </HBox.margin>
        </AnchorPane>



        <!-- AI content -->
        <VBox alignment="CENTER" prefHeight="480.0" prefWidth="626.0" spacing="25" style="-fx-background-color: #eae8e2;">

            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
            </padding>

            <Label alignment="CENTER" prefWidth="560.0" style="-fx-font-weight: bold;" text="Hi there, what can I ‘cook’ for you today?" textAlignment="CENTER" textFill="#573c2a" wrapText="true">
                <font>
                    <Font size="34.0" />
                </font>
            </Label>

            <VBox prefHeight="150.0" prefWidth="520.0" style="-fx-background-color: #eae8e2; -fx-border-color: #ff6600 #2a6c36 #2a6c36 #ff6600; -fx-border-width: 5; -fx-border-radius: 18; -fx-background-radius: 18;">

                <padding>
                    <Insets bottom="10.0" left="12.0" right="12.0" top="10.0" />
                </padding>

                <TextArea fx:id="chatbotInput" prefHeight="100.0" prefWidth="500.0" promptText="Input your prompt here..." style="-fx-background-color: transparent -fx-control-inner-background: #eae8e2 -fx-text-fill: #573c2a -fx-prompt-text-fill: #573c2a -fx-font-size: 20px -fx-font-weight: bold -fx-background-radius: 18;" wrapText="true" />

                <HBox alignment="CENTER_RIGHT" spacing="8">
                    <HBox alignment="CENTER_RIGHT" spacing="8">

                        <Button onAction="#openRecipeView" style="-fx-background-color: #ff6600; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 8 18 8 18;" text="View Recipe" />

                        <Button onAction="#onChatbotInputButtonClick" style="-fx-background-color: #ff6600; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 8 18 8 18;" text="Send" />
                    </HBox>
                </HBox>
                <HBox alignment="CENTER" spacing="10">
                    <Button text="Upload Image" onAction="#onUploadImageClick" style="-fx-background-color: #2a6c36; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 8 18 8 18;" />
                </HBox>

                <ImageView fx:id="uploadedImagePreview" fitWidth="180.0" fitHeight="120.0" preserveRatio="true" />
            </VBox>

            <TextArea fx:id="chatbotOutput" editable="false" prefHeight="170.0" prefWidth="520.0" style="-fx-control-inner-background: #eae8e2;                      -fx-text-fill: #573c2a;                      -fx-font-size: 16px;" wrapText="true" />

        </VBox>

    </children>
</HBox>
